---
import { SITE } from "../config/site";

const links = [
  { label: "Work", href: SITE.links.work },
  { label: "Products", href: SITE.links.products },
  { label: "About", href: SITE.links.about },
  { label: "Writing", href: SITE.links.writing },
];
---

<nav class="border-line border-b">
  <div
    class="shell flex items-center justify-between px-20 py-6.5 max-xl:px-10 max-sm:px-6 max-sm:py-5"
  >
    <a
      href="/"
      class="text-ink text-[15px]/4.5 font-semibold tracking-[0.14em] transition-opacity hover:opacity-60"
    >
      9TH HOUR
    </a>

    <div class="flex items-center gap-9 max-lg:gap-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-ink text-[15px]/4.5 transition-opacity hover:opacity-60 max-md:hidden"
          >
            {link.label}
          </a>
        ))
      }
      <button
        type="button"
        data-modal-open="general"
        class="bg-ink text-paper flex cursor-pointer items-center rounded-md px-4.5 py-3 text-sm/4.5 font-medium transition-opacity hover:opacity-85"
      >
        Tell me the problem &rarr;
      </button>
    </div>
  </div>
</nav>
