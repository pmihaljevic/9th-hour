---
import { SITE } from "../config/site";

const columns = [
  [
    { label: "Symposia", href: SITE.links.symposia },
    { label: "About", href: SITE.links.about },
    { label: "Writing", href: SITE.links.writing },
  ],
  [
    { label: "Email", href: `mailto:${SITE.email}` },
    { label: "Legal", href: SITE.links.legal },
    { label: "Privacy", href: SITE.links.privacy },
  ],
];
---

<footer class="border-line bg-cream border-t">
  <div
    class="shell flex items-start justify-between px-20 py-14 max-xl:px-10 max-md:flex-col max-md:gap-10 max-sm:px-6"
  >
    <div class="flex flex-col gap-2.5">
      <div class="text-ink text-sm/4.5 font-semibold tracking-[0.14em]">
        9TH HOUR
      </div>
      <div class="text-muted font-serif text-[17px]/5.5 italic">
        Software that gives people time back.
      </div>
      <div class="text-muted text-[13px]/4">
        Consulting &middot; Custom software &middot; Products
      </div>
    </div>

    <div class="flex gap-14 max-sm:gap-10">
      {
        columns.map((column) => (
          <div class="flex flex-col gap-2">
            {column.map((link) => (
              <a
                href={link.href}
                class="text-ink text-sm/4.5 transition-opacity hover:opacity-60"
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>

    <div class="flex flex-col items-end gap-2 max-md:items-start">
      <div class="text-muted text-[13px]/4">&copy; 2026 9th Hour d.o.o.</div>
      <div class="text-muted text-[13px]/4">No cookies. No tracking.</div>
    </div>
  </div>
</footer>
