---
import Field from "./Field.astro";
import { SITE } from "../config/site";

const modals = [
  {
    id: "general",
    subject: "9th Hour — general enquiry",
    eyebrow: "GENERAL ENQUIRY",
    title: "Tell me what's taking too much time.",
    titleWidth: "w-150",
    lead: "Don't worry about writing requirements. Describe the problem in your own words.",
    leadWidth: "w-140",
    note: "I read every message. Usually a reply within a day.",
  },
  {
    id: "stuck",
    subject: "9th Hour — existing software",
    eyebrow: "EXISTING SOFTWARE",
    title: "Tell me what's stuck.",
    titleWidth: "",
    lead: "The more concrete the better — what slowed down, and roughly when it started.",
    leadWidth: "w-145",
    note: "If it's urgent, say so — I'll reply the same day.",
  },
  {
    id: "process",
    subject: "9th Hour — the process",
    eyebrow: "THE PROCESS",
    title: "Tell me about the process.",
    titleWidth: "",
    lead: "Describe the workflow as it actually happens today — spreadsheets, email threads and all.",
    leadWidth: "w-145",
    note: "I read every message. Usually a reply within a day.",
  },
];

// Web3Forms needs an absolute URL, and only uses it for the no-JS POST.
const thanksUrl = new URL("/thanks", Astro.site).href;

const situations = ["Rescue", "Migration", "Cleanup", "Senior gap", "Not sure"];
---

{
  modals.map((modal) => (
    <div
      class="modal fixed inset-0 z-100 hidden"
      id={`modal-${modal.id}`}
      role="dialog"
      aria-modal="true"
      aria-labelledby={`modal-${modal.id}-title`}
    >
      <div class="modal-backdrop bg-ink/60 absolute inset-0" data-modal-close />
      <div class="absolute inset-0 overflow-y-auto" data-modal-dismiss>
        <div class="flex min-h-full items-center justify-center p-8 max-sm:p-0">
          <div class="modal-panel bg-cream relative flex w-200 max-w-full flex-col gap-12 rounded-lg p-16 max-md:gap-9 max-md:p-10 max-sm:rounded-none max-sm:p-6">
            <button
              type="button"
              data-modal-close
              aria-label="Close"
              class="text-muted hover:bg-sand hover:text-ink absolute top-7 right-7 flex size-9 cursor-pointer items-center justify-center rounded-full transition-colors max-sm:top-4 max-sm:right-4"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 3l10 10M13 3L3 13"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            </button>

            {/* Heading */}
            <div class="flex flex-col gap-4.5">
              <div class="text-rust text-[13px]/4 font-medium tracking-[0.14em]">
                {modal.eyebrow}
              </div>
              <h2
                id={`modal-${modal.id}-title`}
                class:list={[
                  "text-ink font-serif text-[44px]/12.5 font-medium tracking-[-0.01em] max-sm:text-[32px]/10",
                  modal.titleWidth,
                  "max-w-full",
                ]}
              >
                {modal.title}
              </h2>
              <p
                class:list={[
                  "text-muted text-[17px]/7",
                  modal.leadWidth,
                  "max-w-full",
                ]}
              >
                {modal.lead}
              </p>
            </div>

            <form
              class="contact-form flex flex-col gap-12 max-md:gap-9"
              action="https://api.web3forms.com/submit"
              method="POST"
              data-fallback-email={SITE.email}
            >
              <input
                type="hidden"
                name="access_key"
                value={SITE.web3formsKey}
              />
              <input type="hidden" name="subject" value={modal.subject} />
              <input type="hidden" name="from_name" value="9th Hour website" />
              <input type="hidden" name="redirect" value={thanksUrl} />
              <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display:none"
                tabindex="-1"
                autocomplete="off"
              />

              <div class="flex flex-col gap-8">
                <div class="flex gap-8 max-sm:flex-col max-sm:gap-8">
                  <Field
                    label="Name"
                    name="name"
                    placeholder="Your name"
                    required
                    class="w-80 shrink-0 max-sm:w-full"
                  />
                  <Field
                    label="Email"
                    name="email"
                    type="email"
                    placeholder="you@company.com"
                    required
                    class="w-80 shrink-0 max-sm:w-full"
                  />
                </div>

                {modal.id === "general" && (
                  <Field
                    label="Company"
                    name="company"
                    placeholder="Where you work"
                  />
                )}

                {modal.id === "stuck" && (
                  <div class="flex flex-col gap-3.5">
                    <div class="text-muted text-xs/4 font-medium tracking-[0.12em] uppercase">
                      Closest to your situation
                    </div>
                    <div class="flex gap-2.5 max-sm:flex-wrap">
                      {situations.map((situation, i) => (
                        <label class="cursor-pointer">
                          <input
                            type="radio"
                            name="situation"
                            value={situation}
                            checked={i === 0}
                            class="peer sr-only"
                          />
                          <span class="border-line text-ink peer-checked:border-ink peer-checked:bg-ink peer-checked:text-paper flex rounded-sm border px-4.5 py-2.5 text-sm/4.5 transition-colors peer-checked:font-medium">
                            {situation}
                          </span>
                        </label>
                      ))}
                    </div>
                  </div>
                )}

                {modal.id === "stuck" && (
                  <Field
                    label="Stack & team size"
                    name="stack"
                    placeholder="Rails + React, 6 engineers"
                  />
                )}

                {modal.id === "general" && (
                  <Field
                    label="What's taking too much time?"
                    name="message"
                    placeholder="Four people spend about 60 hours a month reconciling the same data by hand…"
                    textarea
                    required
                  />
                )}

                {modal.id === "stuck" && (
                  <Field
                    label="What's stuck?"
                    name="message"
                    placeholder="We started a migration in spring, it's half-finished, and shipping anything now takes twice as long…"
                    textarea
                    required
                  />
                )}

                {modal.id === "process" && (
                  <>
                    <Field
                      label="What does the process look like today?"
                      name="message"
                      placeholder="Orders arrive by email, someone copies them into a shared sheet, then finance re-keys them into the accounting system…"
                      textarea
                      required
                    />
                    <div class="flex gap-8 max-sm:flex-col">
                      <Field
                        label="How many people touch it?"
                        name="people"
                        placeholder="4"
                        class="w-80 shrink-0 max-sm:w-full"
                      />
                      <Field
                        label="Roughly how many hours a month?"
                        name="hours"
                        placeholder="60"
                        class="w-80 shrink-0 max-sm:w-full"
                      />
                    </div>
                    <p class="text-muted w-150 max-w-full text-sm/6">
                      A rough number is fine. It tells me what the work is
                      actually costing you.
                    </p>
                  </>
                )}
              </div>

              <div class="flex flex-col gap-5">
                <div class="flex items-center gap-6 max-sm:flex-col max-sm:items-start max-sm:gap-4">
                  <button
                    type="submit"
                    class="form-submit bg-ink text-paper flex shrink-0 cursor-pointer items-center rounded-md px-6 py-3.75 text-base/5 font-medium transition-opacity hover:opacity-85 disabled:opacity-50"
                  >
                    <span class="submit-label">Send it to Patrik</span>
                  </button>
                  <p class="form-note text-muted text-[15px]/4.5">
                    {modal.note}
                  </p>
                </div>
                <p class="text-placeholder text-[13px]/4">
                  No cookies. No tracking.
                </p>
              </div>
            </form>

            <div class="form-success hidden flex-col gap-4.5">
              <div class="text-rust text-[13px]/4 font-medium tracking-[0.14em]">
                MESSAGE SENT
              </div>
              <p class="text-ink w-150 max-w-full font-serif text-[32px]/10.5 font-medium">
                Thanks — it's with me.
              </p>
              <p class="text-muted w-140 max-w-full text-[17px]/7">
                I read every message myself. You'll usually hear back within a
                day.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))
}

<script is:inline>
  (() => {
    let lastFocused = null;

    const openModal = (id) => {
      const modal = document.getElementById(`modal-${id}`);
      if (!modal) return;
      lastFocused = document.activeElement;
      modal.classList.remove("hidden");
      modal.dataset.state = "open";
      document.body.classList.add("modal-locked");
      const first = modal.querySelector(
        "input:not([type='hidden']):not(.sr-only), textarea",
      );
      window.requestAnimationFrame(() => first?.focus());
    };

    const closeModal = (modal) => {
      if (!modal || modal.dataset.state === "closing") return;
      modal.dataset.state = "closing";
      window.setTimeout(() => {
        modal.classList.add("hidden");
        delete modal.dataset.state;
        document.body.classList.remove("modal-locked");
        lastFocused?.focus();
      }, 140);
    };

    const openModals = () =>
      [...document.querySelectorAll(".modal")].filter(
        (m) => !m.classList.contains("hidden"),
      );

    document.addEventListener("click", (event) => {
      const trigger = event.target.closest("[data-modal-open]");
      if (trigger) {
        event.preventDefault();
        openModal(trigger.dataset.modalOpen);
        return;
      }
      const closer = event.target.closest("[data-modal-close]");
      if (closer) {
        closeModal(closer.closest(".modal"));
        return;
      }
      // Clicking the space around the panel dismisses too.
      const dismiss = event.target.closest("[data-modal-dismiss]");
      if (dismiss && !event.target.closest(".modal-panel")) {
        closeModal(dismiss.closest(".modal"));
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        openModals().forEach(closeModal);
        return;
      }
      if (event.key !== "Tab") return;
      const modal = openModals()[0];
      if (!modal) return;
      const focusable = [
        ...modal.querySelectorAll(
          "a[href], button:not([disabled]), input:not([type='hidden']):not(.sr-only), textarea, [tabindex]:not([tabindex='-1'])",
        ),
      ].filter((el) => el.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.querySelectorAll(".contact-form").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const button = form.querySelector(".form-submit");
        const label = form.querySelector(".submit-label");
        const note = form.querySelector(".form-note");
        const original = label.textContent;

        button.disabled = true;
        label.textContent = "Sending…";

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error("failed");
          form.classList.add("hidden");
          const success = form.parentElement.querySelector(".form-success");
          success.classList.remove("hidden");
          success.classList.add("flex");
        } catch {
          button.disabled = false;
          label.textContent = original;
          note.textContent = `That didn't send. Email ${form.dataset.fallbackEmail} and I'll pick it up there.`;
          note.classList.add("text-rust");
        }
      });
    });
  })();
</script>
