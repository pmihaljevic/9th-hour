---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ContactModals from "../components/ContactModals.astro";
import { SITE } from "../config/site";

const manualSteps = [
  "Form",
  "Spreadsheet",
  "Email thread",
  "Follow-up",
  "Reconcile",
];

const notThisWork = [
  "Copying data between systems",
  "Checking status manually",
  "Chasing predictable updates",
  "Maintaining fragile workarounds",
  "Compensating for bad software",
];

const approachSteps = [
  {
    label: "1 — Understand",
    body: "I work with the people actually doing the work.",
  },
  {
    label: "2 — Simplify",
    body: "A bad process automated is still a bad process.",
  },
  {
    label: "3 — Build",
    body: "The smallest system that solves the real problem.",
  },
  {
    label: "4 — Leave it better",
    body: "Something your team can actually maintain.",
  },
];

const consulting = [
  {
    title: "Rescue",
    body: "A critical project is stuck and progress is slowing. Someone needs to take ownership.",
  },
  {
    title: "Migration",
    body: "A risky migration needs someone who understands both the existing system and where it needs to go.",
  },
  {
    title: "Cleanup",
    body: "Technical debt is no longer just an engineering concern. It is making the business slower.",
  },
  {
    title: "Senior gap",
    body: "Good developers, but nobody making the difficult technical decisions and owning them across the system.",
  },
];

const beforeSteps = [
  "Registration form",
  "Spreadsheet",
  "Payment check",
  "Invoice",
  "Spreadsheet update",
  "Attendee emails",
];

const results = [
  "Less administration",
  "Fewer mistakes",
  "One source of truth",
  "Less chasing",
];

const founderLinks = [
  { label: "About", href: SITE.links.about },
  { label: "Writing", href: SITE.links.writing },
  { label: "LinkedIn", href: SITE.links.linkedin },
  { label: "GitHub", href: SITE.links.github },
];
---

<Layout>
  <Nav />

  <!-- ============================================================
       Hero
       ============================================================ -->
  <section class="bg-cream">
    <div
      class="shell flex items-start justify-between gap-20 px-20 pt-27.5 pb-32.5 max-xl:px-10 max-lg:flex-col max-lg:gap-16 max-md:pt-16 max-md:pb-20 max-sm:px-6"
    >
      <div class="flex w-200 max-w-full min-w-0 flex-col gap-9 max-lg:w-full">
        <div class="text-rust text-[13px]/4 font-medium tracking-[0.14em]">
          9TH HOUR / SOFTWARE STUDIO
        </div>
        <h1
          class="text-ink font-serif text-[84px]/21.5 font-medium tracking-[-0.015em] max-lg:text-[64px]/17 max-sm:text-[44px]/12.5"
        >
          Software that gives people time back.
        </h1>
        <p class="text-muted w-160 max-w-full text-lg/7.25">
          I build and improve software that removes repetitive work, broken
          workflows, and unnecessary complexity. Sometimes that means fixing the
          software you already have. Sometimes it means building the system that
          should have existed in the first place.
        </p>
        <div
          class="flex items-center gap-7 max-sm:flex-col max-sm:items-start max-sm:gap-5"
        >
          <button
            type="button"
            data-modal-open="general"
            class="bg-ink text-paper flex cursor-pointer items-center rounded-md px-5 py-3.5 text-[15px]/4.5 font-medium transition-opacity hover:opacity-85"
          >
            Tell me what's taking too much time &rarr;
          </button>
          <a
            href="#symposia"
            class="text-ink text-[15px]/4.5 font-medium transition-opacity hover:opacity-60"
          >
            See what I'm building &darr;
          </a>
        </div>
      </div>

      <div
        class="flex w-90 shrink-0 flex-col pt-6 max-lg:w-full max-lg:items-center max-lg:pt-0"
      >
        <div class="flex flex-col items-center gap-1.5">
          <div class="text-muted text-[11px]/3.5 font-medium tracking-[0.14em]">
            MANUAL WORK
          </div>
          <div class="flex flex-col items-center gap-1.5 pt-3">
            {
              manualSteps.map((step, i) => (
                <>
                  {i > 0 && <div class="text-rust text-xs/4">&darr;</div>}
                  <div class="border-line bg-cream text-ink flex w-55 justify-center rounded-sm border py-2.25 text-[13px]/4">
                    {step}
                  </div>
                </>
              ))
            }
          </div>
        </div>
        <div class="flex w-90 max-w-full flex-col items-center gap-4.5 pt-6.5">
          <div class="flex w-65 max-w-full items-center gap-3">
            <div class="bg-line h-px grow"></div>
            <div
              class="text-rust text-[11px]/3.5 font-medium tracking-[0.16em]"
            >
              BECOMES
            </div>
            <div class="bg-line h-px grow"></div>
          </div>
          <div
            class="border-ink bg-cream text-ink flex w-55 justify-center rounded-sm border-[1.5px] py-3.25 text-sm/4.5 font-medium"
          >
            One system
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       01 — Belief
       ============================================================ -->
  <section class="bg-ink-deep">
    <div
      class="shell flex flex-col gap-11 px-20 py-45 max-xl:px-10 max-md:py-28 max-sm:px-6"
    >
      <div class="reveal text-rust text-[13px]/4 font-medium tracking-[0.14em]">
        01 / WHY 9TH HOUR
      </div>
      <h2
        class="reveal text-paper w-215 max-w-full font-serif text-[76px]/20.5 font-medium tracking-[-0.01em] max-lg:text-[56px]/15.5 max-sm:text-[40px]/11.5"
      >
        Some work shouldn't require people.
      </h2>
      <p class="reveal text-muted-dark w-165 max-w-full text-lg/7.5">
        People should make decisions, solve difficult problems, build
        relationships, and create things. They shouldn't spend their days moving
        information between spreadsheets, systems, and inboxes.
      </p>
      <p class="reveal text-paper text-lg/7.5 font-medium">
        9th Hour builds software that removes that work.
      </p>
      <div class="reveal flex w-190 max-w-full flex-col pt-4">
        {
          notThisWork.map((item, i) => (
            <div
              class:list={[
                "border-line-dark flex items-center justify-between border-t py-4",
                i === notThisWork.length - 1 && "border-b",
              ]}
            >
              <div class="text-muted-dark text-base/5">{item}</div>
              <div class="text-rust text-sm/4.5">&mdash; remove</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       02 — The problem
       ============================================================ -->
  <section id="problem" class="bg-cream scroll-mt-8">
    <div
      class="shell flex flex-col gap-16 px-20 py-35 max-xl:px-10 max-md:py-24 max-sm:px-6"
    >
      <div class="flex flex-col gap-7">
        <div
          class="reveal text-rust text-[13px]/4 font-medium tracking-[0.14em]"
        >
          02 / THE PROBLEM
        </div>
        <h2
          class="reveal text-ink w-205 max-w-full font-serif text-[56px]/15.5 font-medium tracking-[-0.01em] max-sm:text-[36px]/11"
        >
          There are two ways software usually wastes your time.
        </h2>
      </div>
      <div
        class="grid grid-cols-2 gap-20 max-xl:gap-12 max-lg:grid-cols-1 max-lg:gap-14"
      >
        <div
          class="reveal border-ink flex min-w-0 flex-col gap-5.5 border-t pt-8"
        >
          <h3
            class="text-ink font-serif text-[38px]/11 font-medium max-sm:text-[30px]/9.5"
          >
            Your software is slowing you down.
          </h3>
          <p class="text-muted text-[17px]/7">
            The product exists, but something isn't working. Delivery has
            slowed, a migration is stuck, technical debt is getting expensive,
            or nobody owns the difficult decisions.
          </p>
          <p class="text-ink text-[17px]/7 font-medium">
            I step in, own the problem, and fix it.
          </p>
          <p class="text-muted text-[15px]/6.5">
            Migrations &middot; architecture &middot; product rescue &middot;
            technical debt &middot; performance &middot; senior ownership
          </p>
          <button
            type="button"
            data-modal-open="stuck"
            class="text-rust cursor-pointer self-start text-[15px]/4.5 font-medium transition-opacity hover:opacity-70"
          >
            Tell me what's stuck &rarr;
          </button>
        </div>
        <div
          class="reveal border-ink flex min-w-0 flex-col gap-5.5 border-t pt-8"
        >
          <h3
            class="text-ink font-serif text-[38px]/11 font-medium max-sm:text-[30px]/9.5"
          >
            The process is slowing you down.
          </h3>
          <p class="text-muted text-[17px]/7">
            Your team has built a workflow around spreadsheets, email,
            copy/paste, and disconnected tools. It works — because people spend
            hours keeping it alive.
          </p>
          <p class="text-ink text-[17px]/7 font-medium">
            I figure out what shouldn't require a person, and build the system
            that removes it.
          </p>
          <p class="text-muted text-[15px]/6.5">
            Internal software &middot; workflow apps &middot; integrations
            &middot; dashboards &middot; automation
          </p>
          <button
            type="button"
            data-modal-open="process"
            class="text-rust cursor-pointer self-start text-[15px]/4.5 font-medium transition-opacity hover:opacity-70"
          >
            Tell me about the process &rarr;
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       03 — How ownership works
       ============================================================ -->
  <section class="bg-sand">
    <div
      class="shell flex flex-col gap-14 px-20 py-40 max-xl:px-10 max-md:py-24 max-sm:px-6"
    >
      <div class="flex flex-col gap-7">
        <div
          class="reveal text-rust text-[13px]/4 font-medium tracking-[0.14em]"
        >
          03 / HOW OWNERSHIP WORKS
        </div>
        <h2
          class="reveal text-ink font-serif text-[56px]/15.5 font-medium tracking-[-0.01em] max-sm:text-[36px]/11"
        >
          Built for you. Or built as a product.
        </h2>
        <p class="reveal text-muted text-lg/7.25">
          Not every software problem should have the same business model.
        </p>
      </div>
      <div
        class="grid grid-cols-2 gap-20 max-xl:gap-12 max-lg:grid-cols-1 max-lg:gap-14"
      >
        <div
          class="reveal border-ink flex min-w-0 flex-col gap-4.5 border-t pt-7"
        >
          <div class="text-muted text-xs/4 font-medium tracking-[0.14em]">
            CUSTOM SOFTWARE
          </div>
          <h3 class="text-ink font-serif text-[32px]/9.5 font-medium">
            Your problem. Your software.
          </h3>
          <p class="text-muted text-[17px]/7">
            If you commission bespoke software, you fund it and you own it.
          </p>
        </div>
        <div
          class="reveal border-ink flex min-w-0 flex-col gap-4.5 border-t pt-7"
        >
          <div class="text-muted text-xs/4 font-medium tracking-[0.14em]">
            9TH HOUR PRODUCTS
          </div>
          <h3 class="text-ink font-serif text-[32px]/9.5 font-medium">
            One problem. Many companies.
          </h3>
          <p class="text-muted text-[17px]/7">
            If 9th Hour invests in solving a repeated market problem, we own the
            product and customers subscribe to it. Symposia is one of those
            products.
          </p>
        </div>
      </div>
      <blockquote
        class="reveal border-rust flex w-215 max-w-full flex-col gap-3.5 border-l-2 py-2 pl-7"
      >
        <p
          class="text-ink font-serif text-[26px]/9 italic max-sm:text-[22px]/8"
        >
          &ldquo;I won't build something you commissioned and then rent your own
          software back to you.&rdquo;
        </p>
        <cite class="text-muted text-[15px]/4.5 not-italic">
          Commercial ownership is agreed before development begins.
        </cite>
      </blockquote>
    </div>
  </section>

  <!-- ============================================================
       04 — Symposia
       ============================================================ -->
  <section id="symposia" class="bg-sage scroll-mt-8">
    <div
      class="shell flex flex-col gap-18 px-20 py-42.5 max-xl:px-10 max-md:py-26 max-sm:px-6"
    >
      <div class="flex flex-col gap-6">
        <div
          class="reveal text-sage-ink text-[13px]/4 font-medium tracking-[0.14em]"
        >
          04 / PRODUCT BY 9TH HOUR
        </div>
        <h2
          class="reveal text-ink font-serif text-[44px]/13.5 font-semibold tracking-[-0.01em]"
        >
          Symposia
        </h2>
        <p
          class="reveal text-ink w-175 max-w-full font-serif text-[34px]/10.5 font-medium max-sm:text-[26px]/9"
        >
          Conference management without losing your weekends.
        </p>
        <div class="flex items-start gap-15 pt-8 max-xl:flex-col max-xl:gap-10">
          <div
            class="flex w-105 max-w-full shrink-0 flex-col gap-7 max-xl:w-full"
          >
            <div class="border-sage-line flex flex-col gap-2 border-t pt-4.5">
              <div
                class="text-sage-ink text-xs/4 font-medium tracking-[0.14em]"
              >
                PROBLEM
              </div>
              <p class="text-sage-body text-base/6.75">
                Organizers were managing registrations, abstracts, reviewers,
                invoices, schedules, and attendee communication across
                spreadsheets, documents, and email.
              </p>
            </div>
            <div class="border-sage-line flex flex-col gap-2 border-t pt-4.5">
              <div
                class="text-sage-ink text-xs/4 font-medium tracking-[0.14em]"
              >
                INTERVENTION
              </div>
              <p class="text-sage-body text-base/6.75">
                So 9th Hour built one system around the workflow.
              </p>
            </div>
          </div>
          <div
            class="border-sage-line flex w-200 max-w-full min-w-0 overflow-clip rounded-md border"
          >
            <img
              src="/symposia-app.png"
              alt="The Symposia dashboard: one system for registrations, abstracts, invoices and schedules."
              width="1552"
              height="933"
              loading="lazy"
              decoding="async"
              class="h-120.25 w-200 max-w-full object-cover max-xl:aspect-[800/481] max-xl:h-auto"
            />
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-start gap-16 max-xl:gap-10">
        <div class="flex w-75 max-w-full shrink-0 flex-col gap-2">
          <div
            class="text-sage-body text-[11px]/3.5 font-medium tracking-[0.14em]"
          >
            BEFORE
          </div>
          <div class="flex flex-col gap-1.25 pt-2.5">
            {
              beforeSteps.map((step, i) => (
                <>
                  {i > 0 && (
                    <div class="text-sage-body px-3.5 text-xs/4">&darr;</div>
                  )}
                  <div class="border-sage-line bg-sage text-ink flex rounded-sm border px-3.5 py-2 text-[13px]/4">
                    {step}
                  </div>
                </>
              ))
            }
          </div>
        </div>

        <div
          class="text-sage-ink shrink-0 pt-37.5 font-serif text-[40px]/12 max-lg:rotate-90 max-lg:pt-0"
        >
          &rarr;
        </div>

        <div class="flex w-75 max-w-full shrink-0 flex-col gap-2">
          <div
            class="text-sage-body text-[11px]/3.5 font-medium tracking-[0.14em]"
          >
            AFTER
          </div>
          <div class="flex flex-col gap-1.25 pt-2.5">
            <div
              class="border-sage-line bg-sage text-ink flex rounded-sm border px-3.5 py-2 text-[13px]/4"
            >
              Registration
            </div>
            <div class="text-sage-body px-3.5 text-xs/4">&darr;</div>
            <div
              class="bg-sage-ink text-paper flex rounded-sm px-3.5 py-3 text-[13px]/4 font-medium"
            >
              Symposia
            </div>
          </div>
        </div>

        <div
          class="border-sage-line flex w-95 max-w-full shrink-0 flex-col border-l pl-10 max-lg:border-l-0 max-lg:pl-0"
        >
          <div
            class="text-sage-body pb-4.5 text-[11px]/3.5 font-medium tracking-[0.16em]"
          >
            AND RESULTS IN
          </div>
          {
            results.map((result) => (
              <div class="text-ink py-2.75 text-[15px]/4.5 font-semibold tracking-widest uppercase">
                {result}
              </div>
            ))
          }
          <a
            href={SITE.links.symposia}
            class="text-sage-ink pt-7 text-[15px]/4.5 font-medium transition-opacity hover:opacity-70"
          >
            Explore Symposia &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       05 — Approach
       ============================================================ -->
  <section class="bg-cream">
    <div
      class="shell flex flex-col gap-18 px-20 py-45 max-xl:px-10 max-md:py-28 max-sm:px-6"
    >
      <div class="flex flex-col gap-7">
        <div
          class="reveal text-rust text-[13px]/4 font-medium tracking-[0.14em]"
        >
          05 / APPROACH
        </div>
        <h2
          class="reveal text-ink font-serif text-[76px]/20.5 font-medium tracking-[-0.01em] max-lg:text-[56px]/15.5 max-sm:text-[40px]/11.5"
        >
          Don't automate the mess.
        </h2>
        <p
          class="reveal text-ink w-170 max-w-full pt-3 font-serif text-[32px]/10.5 italic max-sm:text-[24px]/9"
        >
          The first step isn't writing code. Start with the problem, not the
          technology.
        </p>
      </div>
      <div
        class="grid grid-cols-4 gap-10 max-xl:gap-8 max-lg:grid-cols-2 max-sm:grid-cols-1"
      >
        {
          approachSteps.map((step) => (
            <div class="reveal border-line flex min-w-0 flex-col gap-3 border-t pt-5.5">
              <div class="text-rust text-xs/4 font-medium tracking-widest uppercase">
                {step.label}
              </div>
              <p class="text-muted text-[15px]/6.25">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       06 — Existing software
       ============================================================ -->
  <section class="bg-ink-deep">
    <div
      class="shell flex flex-col gap-14 px-20 py-40 max-xl:px-10 max-md:py-24 max-sm:px-6"
    >
      <div class="flex flex-col gap-7">
        <div
          class="reveal text-rust text-[13px]/4 font-medium tracking-[0.14em]"
        >
          06 / EXISTING SOFTWARE
        </div>
        <h2
          class="reveal text-paper w-210 max-w-full font-serif text-7xl/19.5 font-medium tracking-[-0.01em] max-lg:text-[52px]/14.5 max-sm:text-[38px]/11"
        >
          When the problem is already inside the codebase.
        </h2>
        <p class="reveal text-muted-dark w-[690px] max-w-full text-lg/7.25">
          You don't always need new software. Sometimes you need someone senior
          enough to understand what is actually wrong and take responsibility
          for fixing it.
        </p>
      </div>
      <div
        class="grid grid-cols-4 gap-10 max-xl:gap-8 max-lg:grid-cols-2 max-sm:grid-cols-1"
      >
        {
          consulting.map((item) => (
            <div class="reveal border-line-dark flex min-w-0 flex-col gap-3 border-t pt-5.5">
              <h3 class="text-paper font-serif text-[22px]/7 font-medium">
                {item.title}
              </h3>
              <p class="text-muted-dark text-[15px]/6.25">{item.body}</p>
            </div>
          ))
        }
      </div>
      <div class="flex">
        <button
          type="button"
          data-modal-open="stuck"
          class="bg-paper text-ink flex cursor-pointer items-center rounded-md px-5 py-3.5 text-[15px]/4.5 font-medium transition-opacity hover:opacity-85"
        >
          Tell me what's stuck &rarr;
        </button>
      </div>
    </div>
  </section>

  <!-- ============================================================
       07 — Founder
       ============================================================ -->
  <section id="founder" class="bg-cream scroll-mt-8">
    <div
      class="shell flex items-start gap-20 px-20 py-40 max-xl:gap-12 max-xl:px-10 max-lg:flex-col max-md:py-24 max-sm:px-6"
    >
      <div
        class="border-line bg-sand flex h-130 w-110 max-w-full shrink-0 items-end justify-center overflow-clip rounded-md border max-sm:h-auto"
      >
        <img
          src="/patrik.png"
          alt="Patrik Mihaljević, founder of 9th Hour"
          width="1024"
          height="1024"
          loading="lazy"
          decoding="async"
          class="h-110 w-110 max-w-full shrink-0 object-cover object-center max-sm:h-auto"
        />
      </div>
      <div class="flex w-170 max-w-full min-w-0 flex-col gap-6.5 max-lg:w-full">
        <div
          class="reveal text-rust text-[13px]/4 font-medium tracking-[0.14em]"
        >
          07 / FOUNDER
        </div>
        <h2
          class="reveal text-ink font-serif text-[56px]/17 font-medium tracking-[-0.01em] max-sm:text-[40px]/13"
        >
          I'm Patrik.
        </h2>
        <p class="reveal text-muted text-lg/7.5">
          I'm a software engineer and product builder — architecture,
          engineering teams, migrations, and difficult technical problems. 9th
          Hour is where I apply that experience to one question:
        </p>
        <p
          class="reveal text-ink font-serif text-[38px]/12 font-medium italic max-sm:text-[28px]/10"
        >
          Why is a person still spending time doing this?
        </p>
        <p class="reveal text-muted text-lg/7.5">
          Sometimes the answer is broken software. Sometimes it's a bad
          workflow. Sometimes it's missing software.
        </p>
        <div class="reveal flex gap-6">
          {
            founderLinks.map((link) => (
              <a
                href={link.href}
                class="text-rust text-sm/4.5 font-medium transition-opacity hover:opacity-70"
              >
                {link.label} &rarr;
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       08 — Start here
       ============================================================ -->
  <section class="bg-ink-deep">
    <div
      class="shell flex flex-col items-center gap-8 px-20 py-42.5 max-xl:px-10 max-md:py-28 max-sm:px-6"
    >
      <div class="reveal text-rust text-[13px]/4 font-medium tracking-[0.14em]">
        08 / START HERE
      </div>
      <h2
        class="reveal text-paper w-235 max-w-full text-center font-serif text-[68px]/18.5 font-medium tracking-[-0.01em] max-lg:text-[52px]/14.5 max-sm:text-[36px]/11"
      >
        What's taking too much of your team's time?
      </h2>
      <p
        class="reveal text-muted-dark w-160 max-w-full text-center text-lg/7.5"
      >
        Maybe it's inside your software. Maybe it's inside your operations. Tell
        me what's happening. I'll tell you whether I think software can make it
        better.
      </p>
      <button
        type="button"
        data-modal-open="general"
        class="reveal bg-paper text-ink flex cursor-pointer items-center rounded-md px-6 py-3.75 text-base/5 font-medium transition-opacity hover:opacity-85"
      >
